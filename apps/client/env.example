# Microsoft Entra ID - SPA app registration
# Source: Entra admin center > App registrations > <client SPA>
# Required SPA redirect URI (Authentication > Single-page application):
#   http://localhost:5173/redirect.html
# Copy this file to .env and fill in the values.
VITE_ENTRA_TENANT_ID=<your-tenant-id>
VITE_ENTRA_CLIENT_ID=<spa-client-id>

# Delegated scope exposed by Service A. The SPA only requests Service A's scope;
# Service B is reached through Service A's OBO endpoint.
VITE_SERVICE_A_SCOPE=api://<service-a-client-id>/access_as_user
VITE_SERVICE_A_BASE_URL=http://localhost:8001
