# Microsoft Entra ID - Service A app registration (confidential API / OBO middle tier)
# Source: Entra admin center > App registrations > <Service A>
# Copy this file to .env and fill in the values.
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<service-a-client-id>
ENTRA_CLIENT_SECRET=<service-a-client-secret>

# Scope exposed by Service A that incoming client tokens must contain.
ENTRA_REQUIRED_SCOPE=access_as_user

# Optional: additional accepted audience. By default <client-id> and api://<client-id> are accepted.
# ENTRA_AUDIENCE=api://<service-a-client-id>

# Delegated scope of Service B requested through the On-Behalf-Of flow.
SERVICE_B_SCOPE=api://<service-b-client-id>/access_as_user
SERVICE_B_BASE_URL=http://localhost:8002

# Browser origin allowed to call Service A.
CORS_ORIGINS=http://localhost:5173

# Application log level (uvicorn access logs are controlled by --log-level).
LOG_LEVEL=INFO
