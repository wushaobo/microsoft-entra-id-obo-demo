# Microsoft Entra ID - Service B app registration (pure API)
# Source: Entra admin center > App registrations > <Service B>
# Copy this file to .env and fill in the values.
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<service-b-client-id>

# Optional: additional accepted audience. By default <client-id> and api://<client-id> are accepted.
# ENTRA_AUDIENCE=api://<service-b-client-id>

# Name of the delegated scope exposed by Service B (without the api://.../ prefix).
ENTRA_REQUIRED_SCOPE=access_as_user

# Only needed if a browser calls Service B directly. In this demo Service B is called server-side by Service A.
CORS_ORIGINS=http://localhost:5173
